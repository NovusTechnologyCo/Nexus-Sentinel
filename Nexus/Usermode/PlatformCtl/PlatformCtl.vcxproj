<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{4F8B27E1-06D3-4A19-9C7E-5B1E0A93D2F4}</ProjectGuid>
    <RootNamespace>PlatformCtl</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(ProjectDir)bin\</OutDir>
    <IntDir>$(ProjectDir)obj\</IntDir>
    <TargetName>PlatformCtl</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <CompileAs>CompileAsC</CompileAs>
      <PreprocessorDefinitions>WIN32;NDEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;ZYDIS_STATIC_BUILD;ZYCORE_STATIC_BUILD;ZYDIS_DISABLE_ENCODER;ZYDIS_DISABLE_FORMATTER;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!--
        Zydis, decoder only. `trace flow` walks the target's own instructions in lockstep with its
        PT packets, so it needs a real x86 decoder: a wrong instruction LENGTH does not fail, it
        steps to the wrong next address and every block after that point is fiction.

        Decoder only, and no ZYAN_NO_LIBC here. The encoder and formatter compile to nothing under
        those two defines, and the four Zycore .c files are then unreferenced, which is why none of
        them appear below. This mirrors the configuration NexusBootDxe already proves against MSVC
        rather than inventing a second one.
      -->
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\UEFI\SDK\Zydis\include;$(ProjectDir)..\..\UEFI\SDK\Zydis\dependencies\zycore\include;$(ProjectDir)..\..\UEFI\SDK\Zydis\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        Promote the call-signature warnings to ERRORS. Earned 2026-07-29: a function was used
        before its declaration, C4013 made the compiler assume `extern int f()` with NO parameter
        types, every argument went unchecked, and THE BUILD WAS GREEN. It worked by accident and
        would have broken silently on the first signature change.

        Warnings that only appear in a log nobody has to read are not a check. These are:
          C4013  implicit declaration, so arguments go unchecked
          C4020  too many actual parameters
          C4024  different types for formal and actual parameter
          C4133  incompatible pointer types
          C4211  nonstandard extension: redefined extern to static (same root cause)
        Not TreatWarningAsError wholesale: Level4 flags plenty that is genuinely stylistic here,
        and a build that cries wolf gets its warnings ignored, which is how C4013 survived.

        NOTE: no double hyphen anywhere in this comment. MSBuild rejects it (MSB4024/4025) and
        that trap has now cost four builds.
      -->
      <AdditionalOptions>/we4013 /we4020 /we4024 /we4133 /we4211 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="PlatformCtl.c" />
    <ClCompile Include="PtDecode.c" />
    <ClCompile Include="PtSelfTest.c" />
    <ClCompile Include="PtFlow.c" />
    <ClCompile Include="PtFlowSelfTest.c" />
    <!--
      Third-party sources at Level3. Not because their warnings do not matter, but because this
      project's own /W4 output is a thing that gets READ, and burying it under a library's
      unreferenced-parameter noise is how a real warning goes unnoticed. The /we promotions above
      still apply to every file, ours and theirs.
    -->
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\Decoder.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\DecoderData.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\MetaInfo.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\Mnemonic.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\Register.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\SharedData.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\Utils.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <ClCompile Include="..\..\UEFI\SDK\Zydis\src\Zydis.c">
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="PlatformCtl.rc" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\Include\NexusCoreBoot.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
