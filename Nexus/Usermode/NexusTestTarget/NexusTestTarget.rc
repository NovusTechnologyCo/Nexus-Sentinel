// NexusTestTarget.rc -- version resource.
//
// IDENTITY IS DELIBERATE, same rule as PlatformCtl.rc: OUR OWN company name, never a real vendor's.
// An unsigned binary claiming to be Microsoft is a LOUDER anomaly than one honestly attributed,
// because genuine vendor binaries are code-signed and the mismatch stands out immediately.
//
// ⚠ AND IT MATTERS MORE HERE THAN ANYWHERE ELSE IN THIS REPO. This process deliberately manual-maps
// a PE and cycles a region between high and low entropy -- behaviour that looks, to any scanner,
// exactly like the thing scanners hunt for. It says plainly what it is in its own version resource
// so that anyone who finds it while it is running can tell immediately.
//
// Nothing here contains a build path, machine name or user name.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Novus Technology"
            VALUE "FileDescription",  "Capture Test Target (deliberate manual map; test harness)"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "NexusTestTarget"
            VALUE "OriginalFilename", "NexusTestTarget.exe"
            VALUE "ProductName",      "Platform Support Tools"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
